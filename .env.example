# Copy to .env and adjust. docker compose reads this file automatically;
# export the variables (or use your IDE's run configuration) when running the app on the host.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# MySQL (docker-compose publishes the container on host port 3307)
DB_URL=jdbc:mysql://localhost:3307/ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce
MYSQL_ROOT_PASSWORD=root

# JWT signing secret, at least 32 characters. Required outside the dev profile.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
