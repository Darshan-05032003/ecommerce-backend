# Copy to .env and adjust. docker compose reads this file automatically;
# export the variables (or use your IDE's run configuration) when running the app on the host.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# MySQL (docker-compose publishes the container on host port 3307)
DB_URL=jdbc:mysql://localhost:3307/ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce
MYSQL_ROOT_PASSWORD=root

# Redis (docker-compose publishes the container on host port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# Time to live of the Redis caches (ISO-8601 or Spring duration syntax such as 10m, 1h)
CACHE_TTL_PRODUCTS=10m
CACHE_TTL_CATEGORIES=1h

# Orders: how long idempotency keys are kept, and when the cleanup job runs (Spring cron, six fields)
ORDER_IDEMPOTENCY_KEY_RETENTION=24h
ORDER_IDEMPOTENCY_CLEANUP_CRON="0 15 * * * *"

# Mail (docker-compose publishes MailHog SMTP on 1025; sent mail is visible at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=orders@ecommerce.local

# Executor for asynchronous work (order emails). Rejection policy: CALLER_RUNS, ABORT or DISCARD
ASYNC_CORE_SIZE=2
ASYNC_MAX_SIZE=4
ASYNC_QUEUE_CAPACITY=100
ASYNC_REJECTION_POLICY=CALLER_RUNS

# Calls to @LogExecutionTime beans slower than this are logged at WARN (1ms to 1m)
SLOW_METHOD_THRESHOLD=500ms

# Payment provider. Only "simulated" exists; it moves no money (see README)
PAYMENT_GATEWAY=simulated

# JWT signing secret, at least 32 characters. Required outside the dev profile.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Browser origins allowed to call the API (comma separated, scheme and host only)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Development seed data (dev profile only). The admin password is BCrypt-hashed at startup.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=Admin123!
